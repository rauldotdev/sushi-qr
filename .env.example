# Node Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sushi_qr_db
POSTGRES_USER=sushi_user
POSTGRES_PASSWORD=sushi_secure_password_dev
DATABASE_URL=postgresql://sushi_user:sushi_secure_password_dev@localhost:5432/sushi_qr_db

# Cache & PubSub (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Security & Secrets
JWT_SECRET=dev_jwt_secret_min_32_characters_long_for_auth_tokens!
CORS_ORIGINS=https://localhost,https://127.0.0.1,http://localhost:3000
