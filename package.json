{
  "name": "sushi-qr-backend",
  "version": "1.0.0",
  "description": "Sistema de pedidos por QR para buffet de sushi - Monolito modular con Fastify, PostgreSQL y Redis",
  "private": true,
  "type": "module",
  "main": "dist/main/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main/server.ts",
    "start": "node dist/main/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "tsx src/main/database/migrate.ts",
    "db:seed": "tsx src/main/database/seed.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.4",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "husky": "^9.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.4"
  }
}
